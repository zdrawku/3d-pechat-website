{
  "name": "dprinting-services-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-images": "node scripts/generate-carousel-images.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-llms": "node scripts/generate-llms.js",
    "generate-blog": "node scripts/auto-blog/index.js",
    "prestart": "npm run generate-images",
    "start": "ng serve -o",
    "prebuild": "npm run generate-images && npm run generate-sitemap && npm run generate-llms",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.13",
    "@angular/common": "~21.2.13",
    "@angular/compiler": "~21.2.13",
    "@angular/core": "~21.2.13",
    "@angular/forms": "~21.2.13",
    "@angular/platform-browser": "~21.2.13",
    "@angular/platform-browser-dynamic": "~21.2.13",
    "@angular/router": "~21.2.13",
    "@igniteui/material-icons-extended": "^3.0.0",
    "hammerjs": "~2.0.8",
    "igniteui-angular": "^21.2.3",
    "minireset.css": "~0.0.7",
    "ngx-markdown": "^21.3.0",
    "rxjs": "~7.8.1",
    "tslib": "~2.8.1",
    "zone.js": "^0.16.2"
  },
  "overrides": {
