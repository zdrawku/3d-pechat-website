{
  "name": "dprinting-services-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-images": "node scripts/generate-carousel-images.js",
    "gallery-editor": "node scripts/gallery-editor/server.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-blog-content": "node scripts/generate-blog-content.js",
    "generate-blog-images": "node scripts/generate-blog-images.js",
    "generate-llms": "node scripts/generate-llms.js",
    "generate-blog": "node scripts/auto-blog/index.js",
    "prestart": "npm run generate-images && npm run generate-blog-content",
    "start": "ng serve -o",
    "prebuild": "npm run lint && npm run generate-images && npm run generate-blog-images && npm run generate-sitemap && npm run generate-llms && npm run generate-blog-content",
    "build": "ng build",
    "serve:ssr": "http-server dist/dprinting-services-website/browser -p 8080",
    "watch": "ng build --watch --configuration development",
    "test": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng test",
    "e2e": "playwright test --project=functional",
    "e2e:ui": "playwright test --project=functional --ui",
    "e2e:report": "playwright show-report",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "lighthouse": "lhci autorun",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.13",
    "@angular/common": "21.2.13",
    "@angular/compiler": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/forms": "21.2.13",
    "@angular/platform-browser": "21.2.13",
    "@angular/platform-browser-dynamic": "21.2.13",
    "@angular/platform-server": "21.2.13",
    "@angular/router": "21.2.13",
    "@angular/ssr": "21.2.11",
    "@igniteui/material-icons-extended": "^3.0.0",
    "hammerjs": "~2.0.8",
    "igniteui-angular": "^21.2.3",
    "minireset.css": "~0.0.7",
    "ngx-markdown": "^21.3.0",
    "rxjs": "~7.8.1",
    "tslib": "~2.8.1",
    "zone.js": "^0.16.2"
  },
  "overrides": {
    "reveal-sdk-wrappers-angular": {
      "@angular/core": "^20.3.0",
      "@angular/common": "^20.3.0",
      "rxjs": "~7.8.1"
    }
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "~21.2.11",
    "@angular/compiler-cli": "21.2.13",
    "@anthropic-ai/sdk": "^0.32.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@igniteui/angular-schematics": "^21.2.1510",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.12.1",
    "cheerio": "^1.0.0",
    "eslint": "^10.3.0",
    "http-server": "^14.1.1",
    "jasmine-core": "^6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
