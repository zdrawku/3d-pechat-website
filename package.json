    "glob": "^11.0.3",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "~21.2.11",
    "@angular/compiler-cli": "~21.2.13",
    "@anthropic-ai/sdk": "^0.32.1",
    "@eslint/js": "^10.0.1",
    "@igniteui/angular-schematics": "^21.2.1510",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "^21.4.0",
    "cheerio": "^1.0.0",
    "eslint": "^10.3.0",
    "jasmine-core": "^6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3"
